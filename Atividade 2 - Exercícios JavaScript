5)
let n = Number(prompt("Digite a quantidade de termos:"));
let termo = "";
let soma = 0;
let sequencia = "";

for (let i = 1; i <= n; i++) {
  termo += "1";
  soma += Number(termo);

  sequencia += termo;
  if (i < n) {
    sequencia += " + ";
  }
}

console.log(sequencia);
console.log("A soma é: " + soma);
