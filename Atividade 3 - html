<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>DOM Interativo</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <h1>DOM: Página Interativa com JavaScript</h1>

  <!-- CONTADOR -->
  <button id="mais">Incrementar</button>
  <button id="menos">Decrementar</button>
  <p id="contador">0</p>

  <!-- INPUT -->
  <input type="text" id="texto" placeholder="Digite algo...">
  <p><span id="charCount">0</span> caracteres</p>

  <!-- PARÁGRAFOS -->
  <div id="listaTexto"></div>

  <!-- LISTAS -->
  <label>Escolha o tipo de lista:</label>
  <select id="tipoLista">
    <option value="ul">Lista Não Ordenada</option>
    <option value="ol">Lista Ordenada</option>
  </select>
  <button id="addLista">Adicionar Lista</button>

  <div id="listas"></div>

  <br>
  <button id="reset">Resetar Tudo</button>

  <script src="script.js"></script>
</body>
</html>
